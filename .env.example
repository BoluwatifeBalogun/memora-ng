# Copy to .env (or set these in your hosting panel)
MEMORA_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
# MySQL, as specified in Chapter 3. Leave empty to use a local SQLite file.
DATABASE_URL=mysql+pymysql://memora_user:password@localhost:3306/memora
ADMIN_EMAIL=admin@yourhospital.ng
ADMIN_PASSWORD=choose-a-strong-password
MAX_UPLOAD_MB=96
